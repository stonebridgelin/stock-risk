# 复制为 .env 后填写真实值；.env 不提交。变量集合与 config/settings.py 的 load_settings 一致（有测试）
# Tiingo 密钥（探索集与选参集下载）
TIINGO_API_KEY=
# FRED 密钥
FRED_API_KEY=
# MySQL 校验库连接地址（含密码，不得输出）
MYSQL_VERIFY_URL=
# Tiingo 额度：每小时请求数上限（空 = 用默认值）
TIINGO_PER_HOUR=
# Tiingo 额度：每天请求数上限（空 = 用默认值）
TIINGO_PER_DAY=
# Tiingo 额度：每月新代码数上限（空 = 用默认值）
TIINGO_UNIQUE_PER_MONTH=
# Massive 免费档密钥（T08d-2a 的 probe-massive）
MASSIVE_API_KEY=
# Massive 每分钟请求上限（空 = 免费档命令 5、付费档命令 100）
MASSIVE_PER_MINUTE=
# Massive 付费档（Stocks Advanced）密钥（T08d-2b 起的付费档命令只用此项，不回退到 MASSIVE_API_KEY）
MASSIVE_ADVANCED_API_KEY=
